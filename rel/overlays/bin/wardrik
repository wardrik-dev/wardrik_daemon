#!/bin/sh
# The command you run, also as rik. daemon serve, start, stop, pid, logs and service run the daemon;
# every other command is the CLI, which reaches the daemon over its HTTP API.
set -e

readlink_f () {
  cd "$(dirname "$1")" > /dev/null
  filename="$(basename "$1")"
  if [ -h "$filename" ]; then
    readlink_f "$(readlink "$filename")"
  else
    echo "$(pwd -P)/$filename"
  fi
}

root="$(CDPATH='' cd "$(dirname "$(readlink_f "$0")")/.." && pwd -P)"
node="$root/bin/wardrikd"
config_dir="${WARDRIK_CONFIG_DIR:-"${XDG_CONFIG_HOME:-"$HOME/.config"}/wardrik"}"
state_dir="${WARDRIK_STATE_DIR:-"${XDG_STATE_HOME:-"$HOME/.local/state"}/wardrik"}"

# The env file: one NAME=value a line, for the keys config.yaml names. Each variable this
# environment doesn't set is set from it, for the CLI and the daemon alike.
env_file="${WARDRIK_ENV_FILE:-"$config_dir/env"}"
if [ -r "$env_file" ]; then
  if [ -n "$(find "$env_file" \( -perm -040 -o -perm -004 \) 2> /dev/null)" ]; then
    echo "wardrik: $env_file can be read by others; chmod 600 it" >&2
  fi
  while read -r line || [ -n "$line" ]; do
    line="${line#export }"
    name="${line%%=*}"
    case "$line" in
      "$name" | [!A-Za-z_]*) continue ;;
    esac
    case "$name" in
      *[!A-Za-z0-9_]*) continue ;;
    esac
    eval "[ -z \"\${$name+set}\" ]" || continue
    eval "export $line"
  done < "$env_file"
fi

unit="${XDG_CONFIG_HOME:-"$HOME/.config"}/systemd/user/wardrik.service"
export WARDRIK_PROGRAM="${WARDRIK_PROGRAM:-$(basename "$0")}"

case "${1:-help} ${2:-}" in
  "daemon serve")
    WARDRIK_SERVE=1 exec "$node" start
    ;;
  "daemon start")
    WARDRIK_SERVE=1 "$node" daemon
    echo "Wardrik is starting. See what it logs with: $WARDRIK_PROGRAM daemon logs"
    ;;
  "daemon stop")
    exec "$node" stop
    ;;
  "daemon pid")
    exec "$node" pid
    ;;
  "daemon logs")
    exec tail -n 100 -F "$state_dir"/log/erlang.log.*
    ;;
  "daemon service")
    case "${3:-}" in
      install)
        mkdir -p "$(dirname "$unit")"
        cat > "$unit" <<UNIT
[Unit]
Description=Wardrik
After=network-online.target

[Service]
ExecStart=$root/bin/wardrik daemon serve
Restart=on-failure

[Install]
WantedBy=default.target
UNIT
        systemctl --user daemon-reload
        systemctl --user enable --now wardrik
        echo "Wardrik runs as the service wardrik. See it with: systemctl --user status wardrik"
        ;;
      uninstall)
        systemctl --user disable --now wardrik || true
        rm -f "$unit"
        systemctl --user daemon-reload
        ;;
      *)
        echo "Usage: $WARDRIK_PROGRAM daemon service install | uninstall" >&2
        exit 1
        ;;
    esac
    ;;
  *)
    exec "$node" eval "WardrikDaemon.CLI.halt(System.argv())" "$@"
    ;;
esac
